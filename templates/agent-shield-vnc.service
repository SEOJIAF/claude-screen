# agent-shield: optional VNC view of the agent session, on 127.0.0.1 only.
# Generated by `agent-shield install`. Started by `agent-shield start --vnc`.

[Unit]
Description=agent-shield: VNC server for the agent session (localhost only)
BindsTo=agent-shield.service
After=agent-shield.service

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=%t/agent-shield
# WAYLAND_DISPLAY of the agent session, written by its Sway config.
EnvironmentFile=%t/agent-shield/env
# Listen on 127.0.0.1 only. Reach it from elsewhere through an SSH tunnel.
ExecStart="@WAYVNC@" "--config=@VNC_CONFIG@" 127.0.0.1 @VNC_PORT@
Restart=on-failure
RestartSec=2
