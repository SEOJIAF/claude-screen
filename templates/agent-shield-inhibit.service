# agent-shield: keeps the laptop awake while the agent session runs.
# Generated by `agent-shield install`. Started and stopped by agent-shield.

[Unit]
Description=agent-shield: block sleep, idle and the lid switch while the agent runs

[Service]
Type=simple
# "block" locks: while this process runs, logind refuses ordinary suspend
# requests (such as KDE or GNOME reacting to the lid) and skips its own lid action.
ExecStart="@SYSTEMD_INHIBIT@" --what=sleep:idle:handle-lid-switch --mode=block --who=agent-shield "--why=An AI agent session is running" "@SLEEP@" infinity
