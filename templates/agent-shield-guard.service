# agent-shield: follows your Claude Code sessions (see agent_shield/guard.py).
# Generated by `agent-shield install`. Claude Code's hooks start it, and it
# stops by itself when no Claude session is left.

[Unit]
Description=agent-shield: keep the laptop awake while Claude works

[Service]
Type=simple
ExecStart="@AGENT_SHIELD@" guard
Restart=on-failure
RestartSec=2
