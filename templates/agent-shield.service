# agent-shield: the agent's private, headless Sway session.
# Generated by `agent-shield install` from templates/agent-shield.service.
# Started by `agent-shield start`, never automatically at login.

[Unit]
Description=agent-shield: headless Sway session for an AI agent

[Service]
Type=simple
# A private runtime directory (mode 0700). The agent's Wayland socket is created
# here, and your real desktop's socket in %t is not on the agent's search path.
RuntimeDirectory=agent-shield
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=%t/agent-shield
Environment=SWAYSOCK=%t/agent-shield/sway.sock
Environment=XDG_CURRENT_DESKTOP=sway
Environment=XDG_SESSION_TYPE=wayland
Environment=AGENT_SHIELD_SESSION=1
# Draw into memory only: no GPU, no monitor, no real keyboard or mouse.
Environment=WLR_BACKENDS=headless
Environment=WLR_RENDERER=pixman
Environment=WLR_LIBINPUT_NO_DEVICES=1
# Never hand the real desktop's display, X11 cookie, D-Bus bus or ssh-agent to the agent.
UnsetEnvironment=WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS SSH_AUTH_SOCK
# dbus-run-session gives the session its own D-Bus bus, so apps like Firefox
# can't pass their windows to copies already running on your real desktop.
ExecStart="@DBUS_RUN_SESSION@" -- "@SWAY@" --config "@SWAY_CONFIG@"
Restart=on-failure
RestartSec=2
