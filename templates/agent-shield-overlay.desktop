# agent-shield: lets Plasma's shortcut service toggle the privacy overlay.
# Generated by `agent-shield install`; removed by `agent-shield uninstall`.
[Desktop Entry]
Type=Application
Name=agent-shield overlay
Comment=Show the agent-shield privacy overlay
Exec="@AGENT_SHIELD@" overlay
Icon=system-lock-screen
NoDisplay=true
StartupNotify=false
X-KDE-GlobalAccel-CommandShortcut=true
